# PostgreSQL (system of record)
# Local Docker Compose default:
DATABASE_URL=postgresql+asyncpg://poc:poc@localhost:5432/intelligence_poc
DATABASE_POOL_MODE=direct

# Supabase direct connection (migrations and initial POC runtime):
# DATABASE_URL=postgresql+asyncpg://postgres:[URL_ENCODED_DATABASE_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Copy the exact URI from Supabase Dashboard -> Connect and keep the real value
# only in .env. The application accepts postgresql:// and normalizes it to the
# asyncpg driver; postgresql+asyncpg:// remains the explicit preferred form.

# Vercel runtime: use the Supabase transaction pooler URI (port 6543), not the
# direct migration URI. The application disables asyncpg statement caching and
# SQLAlchemy connection pooling when this mode is selected.
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[URL_ENCODED_DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_POOL_MODE=transaction

# Neo4j (relationship projection — not source of truth)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

LOG_LEVEL=INFO

# Early read-only capability-00 showcase (does not complete FastAPI / simulator)
SHOWCASE_ENABLED=true
API_ENVIRONMENT=local
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
