      "source": [
        "# Capability 12 — FastAPI\n",
        "\n",
        "Thin adapters over application services. Health, projection lag, model versions and command adapters. Routes contain no SQL, Cypher or ML.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "setup",
      "metadata": {},
      "outputs": [],
      "source": [
        "import json\n",
        "import sys\n",
        "from pathlib import Path\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "HERE = Path(\"notebooks/12_fastapi\")\n",
        "if not (HERE / \"generate_outputs.py\").exists():\n",
        "    HERE = Path(\".\")\n",
        "sys.path.insert(0, str(HERE.resolve()))\n",
        "from generate_outputs import main\n",
        "\n",
        "report = main()\n",
        "pd.DataFrame([report[\"metrics\"]])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "commands",
      "metadata": {},
      "outputs": [],
      "source": [
        "pd.DataFrame({\"command\": report[\"commands\"]})"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "models",
      "metadata": {},
      "outputs": [],
      "source": [
        "pd.DataFrame(report[\"catalog\"][\"models\"])[["name\", \"version\", \"kind\", \"served\", \"algorithm\"]]"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "notes",
      "metadata": {},
      "source": [
        "Command adapters write through UnitOfWork (fact + activity + outbox). The simulator UI is capability 13 and is not started.\n"
      ]
    }
